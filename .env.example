# Copy this file to .env and fill in real keys.
# .env is gitignored; .env.example is checked in.

# Used by embed_photos.py — Gemini Embedding 2 (image embedding).
# Mint via Google AI Studio (https://aistudio.google.com/apikey) or
# `gcloud services api-keys create --display-name=boxturtle-embeddings \
#   --api-target=service=generativelanguage.googleapis.com`.
GEMINI_API_KEY=

# Alternative: use Vertex AI instead of an API key (auth via
# `gcloud auth application-default login`). When set, GEMINI_API_KEY is ignored.
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_API_KEY=

# Used by classify_photos.py — Claude Haiku 4.5 (vision categorisation).
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
