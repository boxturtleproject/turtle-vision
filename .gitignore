# Secrets — NEVER commit
.env
.env.*
!.env.example

# Python venv / build artefacts
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/

# Dataset assets (large; provided out-of-band — see README "Prerequisites")
# Image folders are NOT committed. Top-level CSVs in data/ ARE committed so
# that split / classifier scripts can be re-run without API keys.
data/*/
data/embeddings.sqlite
data/embeddings_crop.sqlite
data/embeddings_tight.sqlite
data/sift_*.pkl
/embedding_viz.html

# Crawler is a single-use tool, kept out of the repo
download_photos.py

# Scratch
/tmp/
*.log

# Field-test app: uploaded photos + session log (contain new, unpublished photos)
uploads/
results/

# Generated analysis pages (reference local photos by file:// path)
analysis/out/
